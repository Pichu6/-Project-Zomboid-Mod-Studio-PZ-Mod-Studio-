efault: 1.00\r\nTrueWeight.Medical=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Memento=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Meta=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Metalworking=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Miscellaneous=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Mole=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Music=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Object=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Outdoors=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Packing=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Paint=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Player=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Pottery=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.ProtectiveGear=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Raccoon=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.RecipeResource=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Repair=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Retail_VHS=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Security=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.SkillBook=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Slash=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Spear=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Spider=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Sports=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.SportsWeapon=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Squirrel=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Stab=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Swinging=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Tail=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Tailoring=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Teddy_Bear=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Tool=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.ToolWeapon=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Tools=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Trapping=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.UI=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Vehicle=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.VehicleMaintenance=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.VehicleMaintenanceWeapon=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Wall_Coverings=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Water=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.WaterContainer=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Weapon=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.WeaponCrafted=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.WeaponImprovised=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.WeaponPart=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Weaponry=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Welding=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.World=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Wound=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.ZedDmg=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.Zombie=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.bodywork=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.brakes=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.door=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.engine=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.gastank=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.lights=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.nodisplay=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.seat=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.suspension=1.0\r\n\r\n# Min: 0.00 Max: 256.00 Default: 1.00\r\nTrueWeight.tire=1.0\r\n\r\n# VFE weapons spawning attached to police zombies.\r\nVFE.PoliceWeapons=true\r\n\r\n# Weapons spawning attached to military zombies. (Not just VFE specific ones)\r\nVFE.MilitaryWeapons=true\r\n\r\n# Weapons spawning attached to survivor zombies. (Not just VFE specific ones)\r\nVFE.SurvivorWeapons=true\r\n\r\n# Weapons spawning attached to other zombies zombies, like bikers. (Not just VFE specific ones)\r\nVFE.OtherWeapons=true\r\n\r\n# VFE weapons spawning inside vehicle inventories.\r\nVFE.CarWeapons=true\r\n\r\n# VFE weapons spawning inside of normal houses.\r\nVFE.HouseWeapons=true\r\n\r\n# Multiplier to weapons spawning in houses (Requires previous option enabled) Min: 0.10 Max: 10.00 Default: 1.00\r\nVFE.HouseWeaponsMulti=1.0\r\n\r\n# Allows spawning of weapons like the M60 Machinegun.\r\nVFE.HeavyWeapons=true\r\n\r\n# Global multiplier for how many VFE firearms spawn in containers. Min: 0.10 Max: 10.00 Default: 1.00\r\nVFE.GunLootMulti=1.0\r\n\r\n# VFE firearms spawning in army storage, bunkers and military lockers.\r\nVFE.LootMilitary=true\r\n\r\n# VFE firearms spawning in police, SWAT and security storage.\r\nVFE.LootPolice=true\r\n\r\n# VFE firearms spawning in gun stores and pawn shops.\r\nVFE.LootStore=true\r\n\r\n# VFE firearms spawning in drug labs, dealer shacks and floor-plank stashes.\r\nVFE.LootCriminal=true\r\n\r\n# VFE firearms spawning in hunter, trapper and survival containers.\r\nVFE.LootHunting=true\r\n\r\n# VFE firearms spawning in survivor safehouse stashes that appear as the world ages.\r\nVFE.LootSafehouse=true\r\n\r\n# Vanilla-only firearms (JS14, L92, L94, MSR7T, Trapper Carbine, JS3T) plus the M1911 and both small revolvers stop spawning in the containers VFE fills. They still appear on zombies, in vehicles and in every other vanilla list.\r\nVFE.RemoveVanillaGuns=false\r\n\r\n# Range the x2 scope adds to the weapon. Min: -20 Max: 50 Default: 5\r\nVFE.AT_x2ScopeRange=5\r\n\r\n# Aiming time the x2 scope adds. Higher = slower to aim. Min: -50 Max: 50 Default: 5\r\nVFE.AT_x2ScopeAim=5\r\n\r\n# Range the x4 scope adds to the weapon. Min: -20 Max: 50 Default: 10\r\nVFE.AT_x4ScopeRange=10\r\n\r\n# Aiming time the x4 scope adds. Higher = slower to aim. Min: -50 Max: 50 Default: 10\r\nVFE.AT_x4ScopeAim=10\r\n\r\n# Range the x8 scope adds to the weapon. Min: -20 Max: 50 Default: 15\r\nVFE.AT_x8ScopeRange=15\r\n\r\n# Aiming time the x8 scope adds. Higher = slower to aim. Min: -50 Max: 50 Default: 20\r\nVFE.AT_x8ScopeAim=20\r\n\r\n# Aiming time the red dot adds. Negative = faster to aim. Min: -50 Max: 50 Default: -10\r\nVFE.AT_RedDotAim=-10\r\n\r\n# Aiming time the improved irons add. Negative = faster to aim. Min: -50 Max: 50 Default: -5\r\nVFE.AT_IronSightAim=-5\r\n\r\n# Aiming time the laser adds. Negative = faster to aim. Min: -50 Max: 50 Default: -5\r\nVFE.AT_LaserAim=-5\r\n\r\n# Hit chance the laser adds. Min: -50 Max: 50 Default: 10\r\nVFE.AT_LaserHit=10\r\n\r\n# Aiming time the bipod adds. Negative = faster to aim. Min: -50 Max: 50 Default: -5\r\nVFE.AT_BipodAim=-5\r\n\r\n# Hit chance the bipod adds. Min: -50 Max: 50 Default: 30\r\nVFE.AT_BipodHit=30\r\n\r\n# Range the bipod adds to the weapon. Min: -20 Max: 50 Default: 5\r\nVFE.AT_BipodRange=5\r\n\r\n# Aiming time the recoil pad adds. Negative = faster to aim. Min: -50 Max: 50 Default: -5\r\nVFE.AT_RecoilPadAim=-5\r\n\r\n# Recoil delay the pad adds. Negative = faster follow-up shots. Never lets a weapon reach 0. Min: -20 Max: 20 Default: -2\r\nVFE.AT_RecoilPadDelay=-2\r\n\r\n# Loose rounds one box or pack yields, and how many go back in when packing. Admin panel overrides this. Min: 1 Max: 1000 Default: 20\r\nVFE.Ammo_762=20\r\n\r\n# Loose rounds one box or pack yields, and how many go back in when packing. Admin panel overrides this. Min: 1 Max: 1000 Default: 20\r\nVFE.Ammo_223=20\r\n\r\n# Loose rounds one box or pack yields, and how many go back in when packing. Admin panel overrides this. Min: 1 Max: 1000 Default: 50\r\nVFE.Ammo_22=50\r\n\r\n# Loose rounds one box or pack yields, and how many go back in when packing. Admin panel overrides this. Min: 1 Max: 1000 Default: 20\r\nVFE.Ammo_545=20\r\n\r\n# Loose rounds one box or pack yields, and how many go back in when packing. Admin panel overrides this. Min: 1 Max: 1000 Default: 30\r\nVFE.Ammo_76254=30\r\n\r\n# Loose rounds one box or pack yields, and how many go back in when packing. Admin panel overrides this. Min: 1 Max: 1000 Default: 50\r\nVFE.Ammo_57=50\r\n\r\n# Loose rounds one box or pack yields, and how many go back in when packing. Admin panel overrides this. Min: 1 Max: 1000 Default: 50\r\nVFE.Ammo_46=50\r\n\r\n# Loose rounds one box or pack yields, and how many go back in when packing. Admin panel overrides this. Min: 1 Max: 1000 Default: 90\r\nVFE.Ammo_556bp=90\r\n\r\n# Loose rounds one box or pack yields, and how many go back in when packing. Admin panel overrides this. Min: 1 Max: 1000 Default: 30\r\nVFE.Ammo_m13=30\r\n\r\n# <BHC>Do NOT change this. DEV ONLY. <RGB:1,1,1><LINE> Prints a hella lot of debug info in console.\r\nZombieVirusVaccineBETA.DebugMode=false\r\n\r\n# Completely enables or disables the spawning of Zombie Virus Vaccine items in the world.\r\nZombieVirusVaccineBETA.EnableWorldLoot=true\r\n\r\n# Defines how many chemical items from the mod appear in the world. Default = Default\r\n    -- 1 = Disabled\r\n    -- 2 = Low\r\n    -- 3 = Default\r\n    -- 4 = High\r\nZombieVirusVaccineBETA.LootChemicals=3\r\n\r\n# Expands the loot table to include additional chemical products.\r\nZombieVirusVaccineBETA.ExpandChemicalsLoot=true\r\n\r\n# Enables or disables item spawning in vehicles.\r\nZombieVirusVaccineBETA.EnableVehicleLoot=true\r\n\r\n# Enables or disables item spawning in survivor backpacks.\r\nZombieVirusVaccineBETA.EnableBagsLoot=true\r\n\r\n# Defines how many syringes from the mod appear in the world. Default = Default\r\n    -- 1 = Disabled\r\n    -- 2 = Low\r\n    -- 3 = Default\r\n    -- 4 = High\r\nZombieVirusVaccineBETA.LootSyringes=3\r\n\r\n# Defines how many laboratory equipment books appear in the world. Default = Default\r\n    -- 1 = Disabled\r\n    -- 2 = Low\r\n    -- 3 = Default\r\n    -- 4 = High\r\nZombieVirusVaccineBETA.LootEquipmentBooks=3\r\n\r\n# Defines how many virology and chemistry books appear in the world. Default = Default\r\n    -- 1 = Disabled\r\n    -- 2 = Low\r\n    -- 3 = Default\r\n    -- 4 = High\r\nZombieVirusVaccineBETA.LootVirologyBooks=3\r\n\r\n# Defines whether virology books spawn only in specific locations or are spread throughout the world. Default = Specific locations only\r\n    -- 1 = Expand spawn locations\r\n    -- 2 = Specific locations only\r\n    -- 3 = Make them common\r\nZombieVirusVaccineBETA.VirologyBooksSpawnMode=2\r\n\r\n# Enables or disables blood aging.  <LINE><BHC>It might cause heavy CPU usage for multiplayer servers. If so, consider disabling this feature.\r\nZombieVirusVaccineBETA.BloodAgingMode=true\r\n\r\n# 14 is the default value from the original mod. If issues occur, reduce this value or disable blood aging. Min: 5 Max: 21 Default: 14\r\nZombieVirusVaccineBETA.BloodAgingRadius=14\r\n\r\n# Enable water purification through heat (stoves, microwaves, etc). If disabled, water purification will only be possible by using chlorine tablets. <LINE><BHC>It might cause heavy CPU usage for multiplayer servers. If so, consider disabling this feature.\r\nZombieVirusVaccineBETA.EnableWaterPurification=true\r\n\r\n# The radius within which flasks with water in containers will be searched for purification. Ticks onEveryTenMinutes. Min: 5 Max: 21 Default: 5\r\nZombieVirusVaccineBETA.WaterPurificationRadius=5\r\n\r\n# Enables or disables the spawning of the light painting magazine. If disabled, players will not be able to learn how to paint lights.\r\nZombieVirusVaccineBETA.EnableLightPaints=true\r\n\r\n# If enabled, each time a player remove glasses from a broken window, it will give a shattered glass material<LINE><LINE>Even if it's off, players still can pick up the shattered glass from the ground.\r\nZombieVirusVaccineBETA.AllowWindowGlass=true\r\n\r\n# Allows players to perform autopsies directly on the ground, without the need for a table.\r\nZombieVirusVaccineBETA.AllowAutopsyOnGround=true\r\n\r\n# <BHC>Changing this option will affect game balance. <RGB:1,1,1><LINE> Defines how many ticks are required to complete an autopsy. Lower values = faster. Min: 800 Max: 1800 Default: 1200\r\nZombieVirusVaccineBETA.AutopsySpeed=1200\r\n\r\n# The maximum number of hours before a corpse is considered too decomposed for an autopsy. Min: 2 Max: 72 Default: 12\r\nZombieVirusVaccineBETA.AutopsyMaxHours=12\r\n\r\n# <BHC>Changing this option will affect game balance. <RGB:1,1,1><LINE> How many ticks are reduced from the autopsy time for each First Aid skill level. Min: 0 Max: 30 Default: 30\r\nZombieVirusVaccineBETA.TicksDecreasedByPerkLv=30\r\n\r\n# <BHC>Changing this option will affect game balance. <RGB:1,1,1><LINE> Defines the speed bonus when performing an autopsy on an autopsy table. Default = 50%\r\n    -- 1 = None\r\n    -- 2 = 10%\r\n    -- 3 = 20%\r\n    -- 4 = 30%\r\n    -- 5 = 40%\r\n    -- 6 = 50%\r\n    -- 7 = 60%\r\nZombieVirusVaccineBETA.TableSpeedBonus=6\r\n\r\n# <BHC>Changing this option will affect game balance. <RGB:1,1,1><LINE> Amount of experience gained when performing an autopsy on the ground. Min: 0 Max: 15 Default: 15\r\nZombieVirusVaccineBETA.AutopsyGroundXP=15\r\n\r\n# <BHC>Changing this option will affect game balance. <RGB:1,1,1><LINE> Amount of experience gained when performing an autopsy on a table. Min: 0 Max: 30 Default: 30\r\nZombieVirusVaccineBETA.AutopsyTableXP=30\r\n\r\n# <BHC>Changing this option will affect game balance. <RGB:1,1,1><LINE> Defines the base XP gained in Butchering and First Aid skills. Min: 0 Max: 30 Default: 15\r\nZombieVirusVaccineBETA.CollectPartXP=15\r\n\r\n# <BHC>Changing this option will affect game balance. <RGB:1,1,1><LINE> Defines the base chance of collecting a brain in perfect condition. Min: 0 Max: 15 Default: 10\r\nZombieVirusVaccineBETA.BrainHighOffset=10\r\n\r\n# Defines the hemophobia penalty applied when a character with the Hemophobic trait performs an autopsy.<LINE> Affects the chance of obtaining a brain in perfect condition. Min: 0 Max: 30 Default: 10\r\nZombieVirusVaccineBETA.HemophobicDebuff=10\r\n\r\n# If enabled, scalpels will degrade and break with use.\r\nZombieVirusVaccineBETA.AllowScalpelDegrade=true\r\n\r\n# If enabled, saws will degrade and break with use.\r\nZombieVirusVaccineBETA.AllowSawDegrade=true\r\n\r\n# Enables/Disables Lab Inter Profession Starting Kit <LINE><LINE> While unchecked Lab Intern Profession won't start with research files\r\nZombieVirusVaccineBETA.StartingKit=true\r\n\r\n# IF THE GAME STUTTERS, TURN THIS DOWN FIRST. Everything this mod costs in frame time comes from how many people the world is carrying, and this one setting decides that. The default is deliberately on the generous side so a new world feels inhabited; drop it one step and the county is still populated but noticeably cheaper. Rough guide on a mid-range machine: Deserted and Sparse are close to free, Balanced is the level everything is tested at, Crowded asks real work of a weaker CPU, and Insane is a stress test rather than a way to play. A dedicated server feels every step harder than singleplayer, because it simulates for everyone at once. One knob for every number below it. It sets how many survivors the world carries, how many towns are manned at the start, how often you meet them, whether they travel alone or in groups, how many outposts stand, when raids start and how far apart they are, and how large a raid wave, a scout party or a backup call is. Balanced is the tested default and writes nothing at all, so an existing save keeps every number it already has. Any option you set yourself still wins: the preset only moves options left at their own default, so tune one slider and the preset will not touch it -- the one thing it cannot see is you deliberately choosing the value that was already the default (for the four limits below, also the default of an older version). Offline squads, saved groups, outpost task squads and manned places never go below their defaults on Deserted or Sparse, so a quieter preset never removes anyone from a world already under way; Crowded and Insane raise them, Insane to 60 offline squads (default 18) and 4 task squads per outpost (default 2). Changed during a game, the preset moves only the offline squad and saved group limits until the next load. Insane deliberately goes past the mod's own hard caps: up to 220 live hostiles (tested ceiling 120), 24 outposts (12), 4 per town (2), 12 outdoor camps (6) and 8-strong scout parties (3). It is not tested at those numbers -- expect a heavier server, expect bugs, and back up your save first. Default = Balanced -- the tested default, moderate FPS cost (no change)\r\n    -- 1 = Deserted -- almost nobody left (lightest on FPS)\r\n    -- 2 = Sparse -- a few lone survivors (light on FPS)\r\n    -- 3 = Balanced -- the tested default, moderate FPS cost (no change)\r\n    -- 4 = Crowded -- groups, outposts and frequent raids (heavy on FPS)\r\n    -- 5 = Insane -- past the tested limits, unsupported (will cost frames)\r\nALife.Preset_World=3\r\n\r\n# Allows your profession to change NPC attitudes, including profession rules set in the Creator. Off by default. Faction and folder relations still apply.\r\nALife.ProfessionAffectsAttitude=true\r\n\r\n# The first days of the outbreak, the way they would go. The National Guard holds a checkpoint on the bridge north of West Point, and the first three days bring more of everything. After day 3 the police and the army are gone from the roads for good; the bridge checkpoint is abandoned after 72 hours and everything it placed is removed. On by default.\r\nALife.Realistic_Outbreak=true\r\n\r\n# Off: no hostile factions spawn, and raids and outposts stop. Friendly, neutral and careful NPCs still spawn.\r\nALife.World_HostileEnabled=true\r\n\r\n# Scales the global encounter gate. 100 is the balanced default. Min: 25 Max: 400 Default: 100\r\nALife.Population_RatePercent=100\r\n\r\n# Scales natural group sizes. 100 keeps the authored sizes. Min: 50 Max: 200 Default: 100\r\nALife.Population_PartyPercent=100\r\n\r\n# Distance in tiles at which persistent actors receive physical shells. Min: 40 Max: 250 Default: 90\r\nALife.World_SimRadius=90\r\n\r\n# Hard cap for natural persistent hostile actors. Min: 4 Max: 160 Default: 32\r\nALife.Population_HostileCeiling=32\r\n\r\n# How often NPC gunfire hits players. Medium is each NPC's own aiming skill, unchanged. Very Easy is 40% of it, Easy 65%, Hard 125%, Very Hard 150%, Hardcore 180%. Accuracy against zombies is set on the Combat page. Default = Medium\r\n    -- 1 = Very Easy\r\n    -- 2 = Easy\r\n    -- 3 = Medium\r\n    -- 4 = Hard\r\n    -- 5 = Very Hard\r\n    -- 6 = Hardcore\r\nALife.Combat_AimDifficulty=3\r\n\r\n# Chance per roll for both natural spawners: the faction director rolls once per encounter check interval, the encounter director once per encounter roll interval. Default 25. Min: 0 Max: 100 Default: 25\r\nALife.Encounters_RollPercent=25\r\n\r\n# Game hours between natural hostile encounter checks. Min: 1 Max: 24 Default: 4\r\nALife.Encounters_GapHours=4\r\n\r\n# Extra no-spawn tiles around multiplayer safehouses. Min: 0 Max: 50 Default: 8\r\nALife.World_SafehouseClearance=8\r\n\r\n# Allows hostile A-Life factions to fight one another.\r\nALife.World_FactionWarfare=true\r\n\r\n# Injured hostile NPCs may retreat.\r\nALife.Behavior_Retreat=true\r\n\r\n# Hostile looters may take nearby supplies.\r\nALife.Behavior_Scavenge=true\r\n\r\n# Hostiles walk toward gunfire, shouts and other traces they notice.\r\nALife.Behavior_Investigate=true\r\n\r\n# Members that fall behind close back up on their group instead of drifting.\r\nALife.Behavior_Regroup=true\r\n\r\n# Groups travel together in formation rather than as separate walkers.\r\nALife.Behavior_MarchTogether=true\r\n\r\n# Eligible NPC weapons may survive into corpse inventory.\r\nALife.Drops_WeaponsEnabled=true\r\n\r\n# How often a dead NPC's gun or melee weapon stays on the body. Per NPC profile keeps each profile's own chance from the Creator. Anything else is the chance for every NPC. A spawn from the admin spawner still uses its own row. Needs Allow weapon drops on. Default = Per NPC profile\r\n    -- 1 = Per NPC profile\r\n    -- 2 = Off (0%)\r\n    -- 3 = Very low (0-10%)\r\n    -- 4 = Low (10-20%)\r\n    -- 5 = Moderate (20-30%)\r\n    -- 6 = High (30-50%)\r\n    -- 7 = Very high (50-70%)\r\n    -- 8 = Almost always (70-99%)\r\n    -- 9 = Always (100%)\r\nALife.Drops_WeaponChance=1\r\n\r\n# What shape a dropped weapon is in. Per NPC profile keeps each profile's own rating and the early-game curve, where the first weeks mostly give you broken or nearly broken guns. Anything else is the condition of every dropped weapon, from every NPC. Broken means it has to be repaired before it works. The NPC still fights with it at full strength. Default = Per NPC profile\r\n    -- 1 = Per NPC profile\r\n    -- 2 = Broken (0/10)\r\n    -- 3 = Scrap, a shot or two (1/10)\r\n    -- 4 = Very poor, a few shots (2/10)\r\n    -- 5 = Poor (3/10)\r\n    -- 6 = Worn (4/10)\r\n    -- 7 = Used, half gone (5/10)\r\n    -- 8 = Serviceable (6/10)\r\n    -- 9 = Good (7/10)\r\n    -- 10 = Very good (8/10)\r\n    -- 11 = Near new (9/10)\r\n    -- 12 = Issue fresh (10/10)\r\nALife.Drops_WeaponCondition=1\r\n\r\n# Rounds an NPC is issued at spawn, as a percent of what its profile says. 100 is the profile. Every gun keeps at least one full load. Infinite-ammo profiles are not changed. Min: 0 Max: 200 Default: 100\r\nALife.Ammo_SpawnPercent=100\r\n\r\n# The most spare rounds an NPC can carry for one gun, counted in loads of that gun (its magazine or tube, at least 6 rounds). It caps the spawn kit and ammunition the NPC picks up. 0 means no ceiling. Default 6. Min: 0 Max: 20 Default: 6\r\nALife.Ammo_ReserveLoads=6\r\n\r\n# Which profiles may keep the Infinite ammunition tick. Creator profiles only keeps it for profiles you made or edited; the shipped roster then runs dry like everyone else. Default = Creator profiles only\r\n    -- 1 = Creator profiles only\r\n    -- 2 = Every profile that asks\r\n    -- 3 = Never\r\nALife.Ammo_Bottomless=1\r\n\r\n# On: a body drops at most its profile's magazine limit, filled only from rounds it still carried when it died. Off: one roll per magazine the profile was issued, full, however much was fired.\r\nALife.Ammo_HonestDrops=true\r\n\r\n# Non-revolver NPC firearms can fail to fire, click, then be visibly racked clear.\r\nALife.Combat_EnableJamming=true\r\n\r\n# Base chance per trigger pull for a non-revolver NPC firearm to jam. Zero disables jams even if the feature is enabled. Min: 0.00 Max: 25.00 Default: 1.00\r\nALife.Combat_JamChance=1.0\r\n\r\n# How hard NPCs work a door, a window or a barricade when they break in. 100 is the tested default: a window takes three swings, a plank four, a plain door about half a minute, and only one man swings while the rest cover him. Lower it and they take longer; raise it and they come through faster. Min: 25.00 Max: 200.00 Default: 100.00\r\nALife.Breach_Strength=100.0\r\n\r\n# A two-handed swing by an NPC carries into a second zombie standing in the arc, at three quarters of the blow. Zombies only, never people. Off by default.\r\nALife.Combat_MultiHit=true\r\n\r\n# A round an NPC puts into a zombie goes on into the zombie standing right behind it (up to three squares). Zombies only, never people; better against a horde. Off by default.\r\nALife.Combat_BulletPenetration=true\r\n\r\n# Once per world, the towns' rooms are read and a share of the places a survivor would hold -- police stations, fire houses, clinics and the dentist, gun stores, warehouses, gas stations, motels, diners, churches, schools, stores and houses -- are marked to be manned: Rare 10%, Uncommon 20%, Common 35% of them, every town at least two. A marked place gets its residents the first time a player comes near, from a faction that fits the room: police in the station, the fire department in the fire house, hospital staff on the ward, a family in a house. They are persistent and saved with the world. Off by default; Realistic outbreak does not turn it on. Default = Off\r\n    -- 1 = Off\r\n    -- 2 = Rare\r\n    -- 3 = Uncommon\r\n    -- 4 = Common\r\nALife.Population_PopulateOnStart=1\r\n\r\n# The most places in the whole world that Populate places on start may man, default 45. The places are chosen once per world; the heaviest (stations, fire houses, clinics) are kept first. Min: 1 Max: 200 Default: 45\r\nALife.Population_PopulateMax=45\r\n\r\n# NPCs walk to where a target was last seen and sweep the area before giving up.\r\nALife.Search_Enabled=true\r\n\r\n# Shouting draws every NPC within earshot toward you.\r\nALife.Search_ShoutResponse=true\r\n\r\n# An NPC that spots something tells its group where, once. Not a live feed.\r\nALife.Search_GroupCallout=true\r\n\r\n# With nothing to fight, NPCs search areas where they notice signs of survivors.\r\nALife.Clues_Enabled=true\r\n\r\n# A running or hotwired vehicle marks the area around it as worth searching.\r\nALife.Clues_Vehicles=true\r\n\r\n# Planked windows and doors mark a building as somebody's.\r\nALife.Clues_Barricades=true\r\n\r\n# Player-built walls, gates and fences mark a location as occupied.\r\nALife.Clues_PlayerBuilt=true\r\n\r\n# An active generator is strong evidence somebody is living nearby.\r\nALife.Clues_Power=true\r\n\r\n# Scales how readily NPCs act on traces. Higher investigates weaker evidence; lower needs a stronger lead. Min: 0.25 Max: 5.00 Default: 1.00\r\nALife.Clues_WeightMultiplier=1.0\r\n\r\n# Plays recorded voice clips for what NPCs say. Off by default: NPCs talk in text only. Pain and death sounds are not affected.\r\nALife.Voice_Enabled=true\r\n\r\n# Type in chat near NPCs and they answer: questions, requests, threats, yes or no. They also react with words when you hit them or help them in a fight.\r\nALife.Talk_Enabled=true\r\n\r\n# Single player has no chat window. With this on, the Toggle chat key opens a small line to talk to NPCs. Start a line with ! to shout it.\r\nALife.Talk_SinglePlayerChat=true\r\n\r\n# Friendly and neutral people stop and look at you when you come close and say something; friends passing by say a word; outlaw crews call out a stranger.\r\nALife.Talk_Presence=true\r\n\r\n# Scared ordinary people do not open fire on someone who has not attacked them, and back off when they are badly outgunned. Veterans and predators never do.\r\nALife.Talk_RiskAssessment=true\r\n\r\n# Outlaw crews may hold up a lone player instead of shooting: hands up, the weapon down, three or four valuable items taken, then they leave. Refuse, and they shoot.\r\nALife.Robbery_Enabled=true\r\n\r\n# Scales how often an outlaw crew chooses to rob instead of fighting. 100 is normal, 0 never, 200 twice as often. Min: 0 Max: 200 Default: 100\r\nALife.Robbery_Chance=100\r\n\r\n# A survivor-run station with scanner traffic, military chatter, call-ins, stories, jokes and rumours about what is really happening in your world.\r\nALife.Radio_KnoxCounty=true\r\n\r\n# Default 99600 = 99.6 MHz. Choose an unused FM frequency if the emergency station or another mod already occupies it. The station never replaces another channel. Restart the server after changing this; open a radio to add the matching preset. Min: 88000 Max: 108000 Default: 99600\r\nALife.Radio_KnoxFrequency=99600\r\n\r\n# The spawn panel, encounter list, outpost builder and raid setup. Turn this off for a clean right-click menu; Runtime status and the Creator stay either way. Admins on a server are unaffected.\r\nALife.Debug_ShowAdminTools=true\r\n\r\n# A moving vehicle hurts an NPC it hits, scaled by speed. Turn this off to stop the vehicle check running at all. NPCs still cannot reach you through an intact car window either way.\r\nALife.Combat_VehicleDamage=true\r\n\r\n# Scales how often NPC gunfire hits a ZOMBIE. 100 is unchanged; raise it if crews look helpless against a horde. Does not affect their aim against you. Min: 10 Max: 200 Default: 100\r\nALife.Combat_AimZombiePercent=100\r\n\r\n# Draws a visible streak along each shot an NPC fires. Muzzle flash, gunfire and casings are unaffected either way.\r\nALife.Combat_VisibleTracers=true\r\n\r\n# Armed NPCs get out of the line of fire to reload, break contact when hurt, and fight from behind walls and corners.\r\nALife.Modules_Cover=true\r\n\r\n# A shooter that is losing breaks contact, runs about a block back, holes up out of sight -- inside a building when there is one -- then comes back in from another side. Ranged only; melee always closes.\r\nALife.Modules_Withdraw=true\r\n\r\n# After a fight, a wounded NPC stops, bandages, and loses the limp and the bleeding.\r\nALife.Modules_Healing=true\r\n\r\n# Hits mark NPCs: a leg wound takes their run away, and below ten percent health they bleed out in seconds unless they bandage.\r\nALife.Combat_Wounds=true\r\n\r\n# Allows sprint windows for melee closing, cover moves, and retreats. Off keeps those moves at a run or walk.\r\nALife.Modules_Sprint=true\r\n\r\n# A shooter that loses sight of its target dumps the magazine into the last known position, full auto, spraying left and right. Pistols magdump too.\r\nALife.Modules_Gunner=true\r\n\r\n# The encounter director: patrols, raids, scavenging parties, assassination squads and garrisons rolled from the catalog near players, placed by the map's own town zones.\r\nALife.Encounters_Enabled=true\r\n\r\n# Game minutes between encounter director rolls (sleeping and fast-forward roll too). Default 60, range 10-720. The spawn chance per roll comes from the encounter chance option. Min: 10 Max: 720 Default: 60\r\nALife.Encounters_IntervalMinutes=60\r\n\r\n# How often the Roadside Pickers turn up: small scavenging crews who warn you off and may hold you up, common in the first two weeks and gone by the fourth. 100 is the default weight, 0 turns them off. Min: 0 Max: 300 Default: 100\r\nALife.Encounters_EarlyLooters=100\r\n\r\n# A parked NPC nobody has been near for this many in-game hours is cleaned up. Persistent NPCs (admin anchors, encounter garrisons) never expire. 0 disables the cleanup. Min: 0 Max: 168 Default: 8\r\nALife.Population_DormantTtlHours=8\r\n\r\n# The conduct layer: squad leaders that deploy and rally their group, snipers that keep distance, medics that dress their wounded, ambushers that wait in the dark, stealth killers. Off disables every conduct at once.\r\nALife.Modules_Behaviors=true\r\n\r\n# Armed NPCs keep the gun on their target, or on where it was last seen, while they walk, back off or sidestep.\r\nALife.Modules_Strafe=true\r\n\r\n# Flashlights: NPCs carry a light and see 12 tiles in the dark (20 with the light on you). Night vision: NPCs simply see at night; give them the goggles yourself. Default = Flashlights\r\n    -- 1 = Flashlights\r\n    -- 2 = Night vision\r\nALife.Night_Sight=1\r\n\r\n# How likely a squad is to keep moving and working after dark. The rest find a house for the night or make a camp: they draw the curtains, hang sheets over the windows, sit tight until morning and leave the dead outside alone. No risks: everybody holes up. Risk takers: hardly anybody does. Default = Moderate chance\r\n    -- 1 = No risks\r\n    -- 2 = Low chance\r\n    -- 3 = Moderate chance\r\n    -- 4 = High chance\r\n    -- 5 = Risk takers\r\nALife.Night_Activity=3\r\n\r\n# How many squads travel the map while nobody is near, default 18. They are kept in the save and come back after a restart up to this number; the saved group limit does not apply to them, except at 0 or in local-only mode, where it decides how many are kept. The roaming group rate scales it, and from the fourth day the world thins out to about a third by the third week. 0 turns the offline world off; encounters near players and outposts remain. A change made in game applies within a game minute: a higher number lets new squads found; a lower one, or 0, founds none and the squads already out keep moving until the next load, which retires the extra ones. Min: 0 Max: 500 Default: 18\r\nALife.Offline_SquadCap=18\r\n\r\n# How many groups are written into the save and come back after a restart, default 20. It counts outpost garrisons and crews an admin or an encounter made persistent. Offline squads are not counted: they come back up to the offline squad limit. Residents of places manned at the start are saved with their buildings and not counted either. Everyone else lasts the current session. Lowering it leaves the extra groups out of the next save, never removing anyone in front of you; a change made in game applies within a game minute. Min: 0 Max: 500 Default: 20\r\nALife.Population_PersistentSquadCap=20\r\n\r\n# Simultaneous patrol, scavenging or hunting teams from each outpost. Default 2, at most 4; zero disables dispatches. Crews are session-only; the site remains saved. Min: 0 Max: 4 Default: 2\r\nALife.Outposts_TaskSquadCap=2\r\n\r\n# How often offline squads move and decide. Min: 10 Max: 60 Default: 20\r\nALife.Offline_TickSeconds=20\r\n\r\n# How far an offline squad walks in one in-game hour. Default 150, a walking pace at the default day length; towns are 1700-3400 tiles apart. Min: 20 Max: 400 Default: 150\r\nALife.Offline_TravelTilesPerHour=150\r\n\r\n# A squad that lost people to you and got away comes back for you two to three days later, with backup.\r\nALife.Offline_RevengeEnabled=true\r\n\r\n# Fortified stations, held houses and forest camps appear over time, manned by a garrison that never leaves.\r\nALife.Outposts_Enabled=true\r\n\r\n# How many outposts may stand at the same time. 0 turns them off. Min: 0 Max: 16 Default: 6\r\nALife.Outposts_MaxSites=6\r\n\r\n# How many outposts one town may hold. Min: 1 Max: 3 Default: 1\r\nALife.Outposts_PerCity=1\r\n\r\n# How often the world rolls for a new outpost, in game minutes (sleeping and fast-forward roll too). A world whose clock stands still falls back to the same number of real minutes. Min: 5 Max: 120 Default: 30\r\nALife.Outposts_IntervalMinutes=30\r\n\r\n# The chance each roll founds a new outpost. Min: 0 Max: 100 Default: 20\r\nALife.Outposts_Chance=20\r\n\r\n# A proposed outpost is built only while a player is this close (so the ground is loaded), and never within 40 tiles of anyone. Min: 60 Max: 200 Default: 120\r\nALife.Outposts_BuildRadius=120\r\n\r\n# A built outpost is manned when a player comes this close. Min: 40 Max: 150 Default: 90\r\nALife.Outposts_SpawnRadius=90\r\n\r\n# Relative frequency of natural 1–3-person parties. Faction overrides take priority. Min: 0.00 Max: 20.00 Default: 3.00\r\nALife.Party_LoneWeight=3.0\r\n\r\n# Relative frequency of natural 4+ person groups. Default is one group for every three lone parties. Min: 0.00 Max: 20.00 Default: 1.00\r\nALife.Party_GroupWeight=1.0\r\n\r\n# Minimum time between new offline parties, default 1.5; the offline squad cap still applies. Min: 0.25 Max: 48.00 Default: 1.50\r\nALife.Offline_FoundGapHours=1.5\r\n\r\n# Automatic raids require a successfully spawned enemy scout party, buildup time, and the minimum day. The admin panel can force a raid.\r\nALife.Raid_Enabled=true\r\n\r\n# Automatic raids cannot begin before this world-age day. Min: 0 Max: 365 Default: 14\r\nALife.Raid_MinDay=14\r\n\r\n# Minimum time between automatic full-scale raids. Min: 0.25 Max: 60.00 Default: 14.00\r\nALife.Raid_CooldownDays=14.0\r\n\r\n# Chance to start the scout-led buildup on each check (every 10 game minutes by default). The default 0.02 with a 14-day cooldown means about one full-scale raid every six or seven weeks. 0 turns automatic raids off. Min: 0.00 Max: 100.00 Default: 0.02\r\nALife.Raid_Chance=0.02\r\n\r\n# How often the raid director checks automatic eligibility. Min: 1 Max: 120 Default: 10\r\nALife.Raid_CheckMinutes=10\r\n\r\n# Number of attacking waves per raid. Min: 1 Max: 10 Default: 3\r\nALife.Raid_Waves=3\r\n\r\n# Requested attackers in each wave. Spawn admission still enforces runtime limits. Min: 1 Max: 12 Default: 6\r\nALife.Raid_GroupSize=6\r\n\r\n# Paces reinforcement waves after the initial warning. Min: 1 Max: 120 Default: 5\r\nALife.Raid_WaveDelayMinutes=5\r\n\r\n# Every A-Life helicopter: raid and reinforcement drops, night searchlights and flyovers. Off means none of them fly.\r\nALife.Raid_Helicopter=true\r\n\r\n# Wait this long after scouts successfully arrive before a raid can start. Min: 0.00 Max: 72.00 Default: 6.00\r\nALife.Raid_ScoutBuildupHours=6.0\r\n\r\n# An expired scout report cannot authorize a raid; new scouts must be sent. Min: 1.00 Max: 168.00 Default: 48.00\r\nALife.Raid_ScoutLifetimeHours=48.0\r\n\r\n# Number of enemy scouts sent before an automatic full-scale raid. Min: 1 Max: 6 Default: 3\r\nALife.Raid_ScoutSize=3\r\n\r\n# A squad in contact may call a quick-reaction squad; limited calls, a cooldown, and a real chance of no answer.\r\nALife.Support_Enabled=true\r\n\r\n# Chance of a permitted support call succeeding. Min: 0 Max: 100 Default: 35\r\nALife.Support_Chance=35\r\n\r\n# Minimum game time between successful calls by the same group. Min: 0.00 Max: 24.00 Default: 0.18\r\nALife.Support_CooldownHours=0.18\r\n\r\n# Fallback when the caller/faction has no authored support size. Min: 1 Max: 8 Default: 4\r\nALife.Support_GroupSize=4\r\n\r\n# Limits repeated reinforcement requests from one group. Min: 0 Max: 10 Default: 3\r\nALife.Support_MaxCalls=3\r\n\r\n# Chance for an authorized helicopter spotlight call. Ground-only callers cannot use it. Min: 0 Max: 100 Default: 12\r\nALife.Support_SpotlightChance=12\r\n\r\n# Follows the target player while outdoors; goes dark indoors. Min: 5 Max: 180 Default: 180\r\nALife.Support_SpotlightSeconds=180\r\n\r\n# Duration of the virtual support helicopter presentation. Min: 5 Max: 180 Default: 35\r\nALife.Support_HelicopterSeconds=35\r\n\r\n# Maximum distance for selecting a nearby building; larger values increase search work. Min: 10 Max: 60 Default: 27\r\nALife.Scavenge_BuildingRadius=27\r\n\r\n# Maximum collected items before heading back to the camp/base depot. Min: 1 Max: 24 Default: 8\r\nALife.Scavenge_CarryLimit=8\r\n\r\n# Bring supplies home after searching this many buildings. Min: 1 Max: 8 Default: 2\r\nALife.Scavenge_ReturnAfterBuildings=2\r\n\r\n# Winter adds coats, hats, gloves and scarves to empty slots; summer takes off heavy winter layers. Uniforms keep their uniform. Profiles with their own seasonal outfit sets are left as authored.\r\nALife.Loadouts_SeasonalDress=true\r\n\r\n# Full: squads roam the whole map while nobody is near (offline simulation) and appear when you get close; outposts rise and fall on their own. Local only: no offline squads -- NPC groups exist only near players (cheapest); outposts still rise. Default = Full A-Life (offline squads roam the map)\r\n    -- 1 = Full A-Life (offline squads roam the map)\r\n    -- 2 = Local only (groups near players; outposts stay)\r\nALife.World_Mode=1\r\n\r\n# How often the encounter director rolls a new group near players. Low halves the chance, Abundant triples it (the roll interval is unchanged). Default = Normal\r\n    -- 1 = Low\r\n    -- 2 = Normal\r\n    -- 3 = High\r\n    -- 4 = Very High\r\n    -- 5 = Abundant\r\nALife.Rate_Encounters=2\r\n\r\n# How many groups the world keeps: the spawn multiplier and the offline squad cap together. Low halves both, Abundant triples them (within their own ceilings). Default = Normal\r\n    -- 1 = Low\r\n    -- 2 = Normal\r\n    -- 3 = High\r\n    -- 4 = Very High\r\n    -- 5 = Abundant\r\nALife.Rate_Groups=2\r\n\r\n# How often the factions that are friendly or neutral to the player are picked when a group is founded. Low halves their weight against the hostile ones, Abundant triples it. Default = Normal\r\n    -- 1 = Low\r\n    -- 2 = Normal\r\n    -- 3 = High\r\n    -- 4 = Very High\r\n    -- 5 = Abundant\r\nALife.Rate_Survivors=2\r\n\r\n# Distant gunfire, helicopters, car crashes and the world's ambience: Low halves the daily and weekly caps and doubles the gap between events, Abundant triples the caps and shortens the gap. Default = Normal\r\n    -- 1 = Low\r\n    -- 2 = Normal\r\n    -- 3 = High\r\n    -- 4 = Very High\r\n    -- 5 = Abundant\r\nALife.Rate_MetaEvents=2\r\n\r\n# How many outdoor sites -- forest camps, field bases, aid stations, depots -- may stand at once, on top of the per-town limit for fortified buildings. 0 disables outdoor sites. Min: 0 Max: 8 Default: 2\r\nALife.Outposts_OutsideCity=2\r\n\r\n# Patrols and scout parties stop off the road every few hours and after a fight: a circle, one sits, one smokes, the rest drink and talk, then the route resumes.\r\nALife.PatrolRest_Enabled=true\r\n\r\n# The shortest rest, in game minutes. Min: 5 Max: 180 Default: 20\r\nALife.PatrolRest_MinMinutes=20\r\n\r\n# The longest rest, in game minutes. Min: 10 Max: 240 Default: 45\r\nALife.PatrolRest_MaxMinutes=45\r\n\r\n# Game hours between scheduled rests, per squad, with some jitter. A rest after a fight comes on its own. Min: 0.50 Max: 48.00 Default: 3.00\r\nALife.PatrolRest_EveryHours=3.0\r\n\r\n# Zombies hear less in heavy rain, blizzards and strong wind: footsteps, doors, fighting and gunshots carry a shorter distance. On top of the game's own small rain and fog effect.\r\nTWGameplay.RainMasksNoise=true\r\n\r\n# 0 = no extra effect, 0.5 = a downpour cuts how far zombies hear by about a quarter, 1 = by about half (never below the minimum below). Min: 0.00 Max: 1.00 Default: 0.50\r\nTWGameplay.NoiseMasking=0.5\r\n\r\n# For a few seconds after a nearby thunder clap reaches you, zombies hear much less. Time your shot with the thunder.\r\nTWGameplay.ThunderMasksNoise=true\r\n\r\n# Zombies always keep at least this fraction of their hearing distance, whatever the weather. Min: 0.20 Max: 1.00 Default: 0.55\r\nTWGameplay.MinHearing=0.55\r\n\r\n# Fog, downpours, heavy snow and white-outs shorten how far zombies can spot you, beyond the game's own limit.\r\nTWGameplay.WeatherLimitsSight=true\r\n\r\n# 0 = no extra effect, 0.5 = thick fog roughly halves the spotting distance, 1 = stronger still (never below the minimum below). Min: 0.00 Max: 1.00 Default: 0.50\r\nTWGameplay.SightReduction=0.5\r\n\r\n# Zombies always keep at least this fraction of their spotting distance, whatever the weather. Min: 0.20 Max: 1.00 Default: 0.40\r\nTWGameplay.MinSight=0.4\r\n\r\n# The game's weather falls in places, not everywhere at once: storms several kilometres across drift over the map, fog lies in banks, showers pass by. Rain barrels fill, crops get watered, you get wet, fires go out and zombies react only where it is actually raining. Off: the game's map-wide weather. Forced weather (admin climate controls) is always map-wide.\r\nTWGameplay.RegionalWeather=true\r\n\r\n# How big the storm areas, fog banks and showers are. 1 = several kilometres across (a few storms over the whole map); 2 = twice as large; 0.5 = half. Min: 0.40 Max: 2.50 Default: 1.00\r\nTWGameplay.StormSize=1.0\r\n\r\n# Lightning takes the tallest thing near where it comes down. Out in the open, with no tree or building near, that is you: a direct hit burns badly and knocks you down or kills you, a strike within 3 tiles burns and knocks you down, within 8 tiles the shock through the ground staggers you. Trees, buildings, roofs and vehicles protect you. Nobody is aimed at.\r\nTWGameplay.LightningHitsPlayers=true\r\n\r\n# Chance that a direct lightning hit kills. 0 = always survivable (heavy burns), 0.3 = about one in three, 1 = always deadly. Min: 0.00 Max: 1.00 Default: 0.30\r\nTWGameplay.LightningDeathChance=0.3\r\n\r\n# How many extra ground strikes come down at random over a thunderstorm (the game's own are spread over kilometres). 1 = about one every 45 seconds within a few hundred metres of each player; 0 = only the game's own strikes. Min: 0.00 Max: 4.00 Default: 1.00\r\nTWGameplay.LightningFrequency=1.0\r\n\r\nRollingHillsPhysics.Enabled=true\r\n\r\nRollingHillsPhysics.Strength=2\r\n\r\nRollingHillsPhysics.CrestJumps=true\r\n\r\n# Min: 50 Max: 120 Default: 70\r\nRollingHillsPhysics.MinimumJumpSpeed=70\r\n\r\n# Min: 4 Max: 40 Default: 24\r\nRollingHillsPhysics.TerrainIntensity=24\r\n\r\n# Min: 600 Max: 2400 Default: 900\r\nRollingHillsPhysics.TerrainWavelength=900\r\n\r\n# On: a trailer or pickup that tips over drops its cargo onto the ground. Off: the cargo stays in the trunk. Each player's own Spill on flip option still applies when this is on.\r\nTrailerCargo.ItemSpill=true\r\n\r\n# On: cars loaded on the W900 car trailer are thrown off when it rolls. Off: they stay loaded. Each player's own Spill on flip option still applies when this is on.\r\nTrailerCargo.CarSpill=true\r\n\r\n# Multiplies the damage a car takes when it lands after a spill. 1.0 is normal, 0.0 none, 2.0 double. Min: 0.00 Max: 4.00 Default: 1.00\r\nTrailerCargo.CarSpillDamage=1.0\r\n\r\n# Physical throws aimed with Viewpoint's camera. Off: vanilla throwing (still aimed through Viewpoint's crosshair instead of at your feet).\r\nViewpointThrowables.Enabled=true\r\n\r\n# Scales every throw speed. Min: 0.25 Max: 3.00 Default: 1.00\r\nViewpointThrowables.StrengthMultiplier=1.0\r\n\r\n# Speed of a quick tap. Min: 0.50 Max: 20.00 Default: 5.00\r\nViewpointThrowables.MinThrowSpeed=5.0\r\n\r\n# Speed of a fully charged overhand throw of a 1 kg object. 16 m/s reaches about 25 m on flat ground. Min: 2.00 Max: 40.00 Default: 16.00\r\nViewpointThrowables.MaxThrowSpeed=16.0\r\n\r\n# How long the throw input must be held for a full-strength throw. Min: 0.10 Max: 6.00 Default: 1.10\r\nViewpointThrowables.ChargeTime=1.1\r\n\r\nViewpointThrowables.EnableUnderhand=true\r\n\r\nViewpointThrowables.EnableRolling=true\r\n\r\n# Share of the thrower's own velocity added to the throw. Min: 0.00 Max: 1.50 Default: 0.60\r\nViewpointThrowables.MomentumInfluence=0.6\r\n\r\n# Damage scales with mass x impact speed and is deliberately conservative.\r\nViewpointThrowables.ImpactDamage=true\r\n\r\n# Min: 0.00 Max: 5.00 Default: 1.00\r\nViewpointThrowables.ImpactDamageMultiplier=1.0\r\n\r\n# Also needs PVP enabled on the server; safety mode is respected.\r\nViewpointThrowables.PlayerImpactDamage=true\r\n\r\n# Impacts make a world sound zombies investigate (vanilla sound system).\r\nViewpointThrowables.ZombieDistraction=true\r\n\r\n# Min: 0.00 Max: 4.00 Default: 1.00\r\nViewpointThrowables.DistractionMultiplier=1.0\r\n\r\n# Bottles, cans, rocks, tools and other small objects can be thrown.\r\nViewpointThrowables.ObjectThrowing=true\r\n\r\n# Min: 0.10 Max: 10.00 Default: 3.00\r\nViewpointThrowables.MaxObjectWeight=3.0\r\n\r\n# Bounciness of explosives, smoke and noise makers. Min: 0.00 Max: 2.00 Default: 1.00\r\nViewpointThrowables.GrenadeBounceMultiplier=1.0\r\n\r\n# Bounciness of ordinary objects. Min: 0.00 Max: 2.00 Default: 1.00\r\nViewpointThrowables.ObjectBounceMultiplier=1.0\r\n\r\n# A fast object smashes a closed, intact, unbarricaded window.\r\nViewpointThrowables.WindowBreaking=true\r\n\r\n# The server checks item ownership, release point, speed, rate and fuse of every throw.\r\nViewpointThrowables.ServerValidation=true\r\n\r\n# The most a player may choose in their own settings. Default = Full\r\n    -- 1 = Off\r\n    -- 2 = Simple\r\n    -- 3 = Full\r\nViewpointThrowables.MaxPreview=3\r\n\r\n# Only items registered as cookable; vanilla throwables are not.\r\nViewpointThrowables.AllowCooking=true\r\n\r\n# Min: 1 Max: 50 Default: 6\r\nViewpointThrowables.MaxActivePerPlayer=6\r\n\r\n# Min: 0.00 Max: 3.00 Default: 0.35\r\nViewpointThrowables.ThrowCooldown=0.35\r\n\r\n# Min: 0.20 Max: 3.00 Default: 1.00\r\nViewpointThrowables.GravityMultiplier=1.0\r\n\r\n# Verbose [ViewpointThrow] log lines (classification, collisions, corrections).\r\nViewpointThrowables.DebugLogging=false\r\n\r\n# Lets every player use the debug drawing option, not just admins.\r\nViewpointThrowables.AllowDebugDraw=false\r\n\r\n# A flashbang whites out the screen of every player who sees it go off: more when closer and looking at it, less around a corner.\r\nViewpointThrowables.FlashbangBlinds=true\r\n\r\n# Beyond this distance a flashbang does not blind. Min: 4.00 Max: 40.00 Default: 16.00\r\nViewpointThrowables.FlashbangRange=16.0\r\n\r\n# How fast molotov and incendiary fire burns zombies to death (1 = a few seconds in the flames). 0 leaves it to the game's own fire, which rarely kills. Min: 0.00 Max: 5.00 Default: 1.00\r\nViewpointThrowables.FireDamageMultiplier=1.0\r\n\r\n# How fast 40 mm grenades leave a launcher (M79, M203). 32 gives a visible lob that reaches about 100 m at the highest arc. A real M79 is about 76, which is very fast and very far for Project Zomboid. Min: 10.00 Max: 90.00 Default: 32.00\r\nViewpointThrowables.LauncherSpeed=32.0\r\n\r\n# Firearms fire simulated projectiles (travel time, drop, walls) instead of vanilla's instant hits while Viewpoint first/third person aiming is active.\r\nVTB.Enabled=true\r\n\r\n# Also use projectiles when Viewpoint is off, aimed along vanilla's aim direction. Off = vanilla firearm combat in the isometric view.\r\nVTB.UseInIsoView=true\r\n\r\n# Multiplies every muzzle velocity. Real velocities (1.0) make drop almost invisible at Project Zomboid distances; 0.4 gives noticeable travel time and drop at long range. Min: 0.05 Max: 3.00 Default: 0.40\r\nVTB.VelocityScale=0.4\r\n\r\n# Multiplies 9.81 m/s2 gravity acting on rounds in flight. Min: 0.00 Max: 10.00 Default: 1.00\r\nVTB.GravityScale=1.0\r\n\r\n# Multiplies air drag. Higher values make rounds lose speed (and damage) faster. Min: 0.00 Max: 10.00 Default: 1.00\r\nVTB.DragScale=1.0\r\n\r\n# How much remaining energy matters: 0 = full vanilla damage at any range, 1 = damage scales with kinetic energy left. Min: 0.00 Max: 1.00 Default: 0.50\r\nVTB.DamageFalloff=0.5\r\n\r\n# Rounds are removed after this many seconds of flight. Min: 0.20 Max: 20.00 Default: 3.00\r\nVTB.ProjectileLifetime=3.0\r\n\r\n# Rounds fly up to the weapon's MaxRange times this. In multiplayer this needs the True Ballistics jar on the server, otherwise hits stay inside vanilla range. Min: 1.00 Max: 20.00 Default: 3.00\r\nVTB.MaxDistanceMultiplier=3.0\r\n\r\n# Absolute limit for any round, in metres (tiles). Min: 10.00 Max: 1000.00 Default: 200.00\r\nVTB.MaxDistanceCap=200.0\r\n\r\n# Distance at which rounds cross the reticle again. 0 = the bore points straight at the reticle, so rounds always land a little low. Scope mods can override this per sight. Min: 0.00 Max: 1000.00 Default: 0.00\r\nVTB.ZeroDistance=0.0\r\n\r\n# Multiplies the dispersion that comes from weapon accuracy, Aiming skill, movement, moodles and weapon condition. Min: 0.00 Max: 10.00 Default: 1.00\r\nVTB.SpreadScale=1.0\r\n\r\n# Rifle rounds with enough energy can pass through a body and hit what is behind it.\r\nVTB.Penetration=true\r\n\r\n# The body part the round physically hit is used for vanilla's head/torso/limb damage, and a shot player is wounded on exactly that part (hands and feet included). Off = vanilla's random body part.\r\nVTB.HitLocations=true\r\n\r\n# Solid furniture and counters stop rounds (tall solid objects up to 1.9 m, counters/tables up to 0.9 m).\r\nVTB.FurnitureCollision=true\r\n\r\n# Multiplayer: the server rejects firearm hits that had no line of fire or impossible damage. Needs the True Ballistics jar on the server.\r\nVTB.ServerValidation=true",
    "settings": 1000,
    "mod_settings": 798
  }
}